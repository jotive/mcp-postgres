# Configure one or more READ-ONLY targets. The DSN MUST point at a role with only
# SELECT privileges (see ADR-001 layer 2). A superuser DSN defeats the safety model.
#
# Create the role once:
#   CREATE ROLE mcp_ro LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE mydb TO mcp_ro;
#   GRANT USAGE ON SCHEMA public TO mcp_ro;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO mcp_ro;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO mcp_ro;

MCPPG_TARGETS=[{"name":"dev","dsn":"postgresql://mcp_ro:PASSWORD@localhost:5432/mydb","max_rows":1000,"statement_timeout_ms":5000}]
MCPPG_DEFAULT_TARGET=dev
MCPPG_AUDIT_PATH=audit.log.jsonl
